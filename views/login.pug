extends layout

block content
  div.auth-page
    div.auth-tabs
      button.auth-tab#tab-login(onclick='showTab("login")') Login
      button.auth-tab#tab-signup(onclick='showTab("signup")') Sign Up

    div#panel-login.auth-panel
      h2 Welcome back
      if error
        p.auth-error= error
      form(method='POST', action='/login')
        input(type='hidden', name='next', value=next)
        div.field-group
          label Username
          input(type='text', name='username', required, autocomplete='username')
        div.field-group
          label Password
          input(type='password', name='password', required, autocomplete='current-password')
        button.login-signup(type='submit') Login

    div#panel-signup.auth-panel(style='display:none')
      h2 Create an account
      if signupError
        p.auth-error= signupError
      form(method='POST', action='/signup')
        div.field-row
          div.field-group
            label First Name
            input(type='text', name='first_name', required)
          div.field-group
            label Last Name
            input(type='text', name='last_name', required)
        div.field-group
          label Username
          input(type='text', name='username', required, autocomplete='username')
        div.field-group
          label Email
          input(type='email', name='email', required)
        div.field-group
          label Phone Number
          input(type='tel', name='phone', required)
        div.field-row
          div.field-group
            label Password
            input(type='password', name='password', required, minlength='6', autocomplete='new-password')
          div.field-group
            label Confirm Password
            input(type='password', name='confirm_password', required, autocomplete='new-password')
        button.login-signup(type='submit') Create Account

  script.
    function showTab(tab) {
      document.getElementById('panel-login').style.display  = tab === 'login'  ? 'block' : 'none';
      document.getElementById('panel-signup').style.display = tab === 'signup' ? 'block' : 'none';
      document.getElementById('tab-login').classList.toggle('active',  tab === 'login');
      document.getElementById('tab-signup').classList.toggle('active', tab === 'signup');
    }
    document.getElementById('tab-login').classList.add('active');
    if (!#{JSON.stringify(!signupError)}) showTab('signup');