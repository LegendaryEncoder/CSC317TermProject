html
  head
    title Special Sword Shop
    link(rel='stylesheet', href='/css/style.css')
  body
    nav
      a(href='/') Home
      a(href='/products') Products
      if user
        a(href='/cart') Cart
        if user.is_admin
          a(href='/admin') Admin
        a(href='/profile') #{user.first_name}
        form.nav-form(method='POST', action='/logout')
          button.nav-logout(type='submit') Logout
      else
        a(href='/login') Login
    block content
    footer
      p Special Sword Shop 2026